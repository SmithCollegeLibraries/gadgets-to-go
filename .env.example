VITE_BASE_URL=/
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AUTH_URL=http://localhost:8000/admin/authorize.php
# Opt in only while generating setup YAML, then set back to false and rebuild/restart.
VITE_ENABLE_SETUP_CONFIG=false

APP_ENV=dev
YII_DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-bytes
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
TRUSTED_PROXIES=
SECURITY_FRAME_ANCESTORS=
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
ENABLE_HSTS=false
FRONTEND_BASE_URL=http://localhost:5173

DB_DSN=mysql:host=db;dbname=gadgets_to_go
DB_USER=gadgets_to_go
DB_PASSWORD=gadgets_to_go
DB_CHARSET=utf8mb4

FOLIO_USERNAME=
FOLIO_PASSWORD=
FOLIO_API_KEY=
FOLIO_TENANT_ID=
# Inventory auth always posts to /authn/login-with-expiry and reuses the folioAccessToken cookie.
# Temporarily set to true while debugging FOLIO connection issues. Logs sanitized request status only.
FOLIO_DEBUG=false
# EBSCO Edge RTAC base for real-time availability, e.g. https://edge-example.folio.ebsco.com
FOLIO_AVAILABILITY_BASE_URL=
# FOLIO API/Okapi base for inventory search, e.g. https://api-example.folio.ebsco.com
FOLIO_INVENTORY_BASE_URL=
# Backward-compatible aliases if an existing deployment already uses these names.
FOLIO_BASE_URL=
FOLIO_OKAPI_URL=
FOLIO_RTAC_BASE_PATH=/prod/rtac/folioRTAC?mms_id=

AUTH_PROVIDERS=shibboleth,local
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=replace-with-a-strong-password
LOCAL_ADMIN_EMAIL=admin@example.edu
LOCAL_ADMIN_NAME=Local Administrator
LOCAL_ADMIN_INSTITUTION=local
SHIB_ID_ATTRIBUTE=eppn
SHIB_USERNAME_ATTRIBUTE=uid
SHIB_FIRST_NAME_ATTRIBUTE=givenName
SHIB_LAST_NAME_ATTRIBUTE=sn
SHIB_EMAIL_ATTRIBUTE=mail
# Optional. Attribute whose value identifies an institution/campus.
SHIB_INSTITUTION_ATTRIBUTE=
# Optional. Comma-separated attribute value to institution slug map, e.g. main:main-library,law:law-library
SHIB_INSTITUTION_MAP=
# Optional full Symfony Mailer DSN. If set, this overrides SMTP_SCHEME/HOST/PORT/USERNAME/PASSWORD.
SMTP_DSN=
SMTP_SCHEME=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.edu
ACCESS_REQUEST_RECIPIENTS=admin@example.edu
MAX_UPLOAD_BYTES=5242880
